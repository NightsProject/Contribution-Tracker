# Contribution Tracker Environment Variables
# Copy this file to .env and adjust values as needed

# Application
APP_NAME=Contrib
WEB_PORT=8000
APP_DOMAIN=localhost

# Database (PostgreSQL)
# For local development: POSTGRES_HOST=localhost
# For Docker Compose:    POSTGRES_HOST=db (service name)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=contribution_tracker
POSTGRES_USER=contribution
POSTGRES_PASSWORD=change-me-for-local-development

# Security
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=28800

# File uploads
UPLOADS_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=5242880

# Timezone
TIMEZONE=Asia/Manila